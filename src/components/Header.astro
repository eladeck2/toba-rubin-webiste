---
import { nav, site, contact } from '../config/site';
const items = nav.filter((item) => item.ready);
const path = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <span class="wordmark__name">Tova</span><span class="wordmark__last"> Rubin</span>
    </a>

    {items.length > 0 && (
      <nav class="site-nav" aria-label="Main">
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <a class="btn site-header__cta" href={contact.href} data-header-cta><span class="cta-long">{contact.ctaShort}</span><span class="cta-short" aria-hidden="true">Book a call</span></a>

    {items.length > 0 && (
      <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu-sheet" data-menu-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        <span class="visually-hidden">Menu</span>
      </button>
    )}
  </div>
</header>

{items.length > 0 && (
  <dialog class="menu-sheet" id="menu-sheet" aria-label="Menu" data-menu>
    <div class="menu-sheet__inner">
      <button class="menu-sheet__close" type="button" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        <span class="visually-hidden">Close menu</span>
      </button>
      <nav aria-label="Main">
        <ul>
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {items.map((item) => (
            <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </dialog>
)}

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    padding-top: env(safe-area-inset-top);
    color: var(--ink);
    transition: color 600ms ease, background-color 400ms ease, box-shadow 400ms ease;
  }
  .site-header[data-solid] {
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header[data-tone='dark'] { color: #F1E8DC; }
  .site-header[data-solid][data-tone='dark'] {
    background: rgb(22 26 41 / 0.82);
    box-shadow: 0 1px 0 rgb(241 232 220 / 0.1);
  }
  .site-header__inner {
    height: 100%;
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.5rem;
    font-weight: 420;
    letter-spacing: -0.015em;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
    line-height: 1;
  }
  .wordmark__last { font-weight: 300; }
  .wordmark { white-space: nowrap; }
  .cta-short { display: none; }
  @media (max-width: 420px) {
    .wordmark { font-size: 1.3125rem; }
    .site-header__cta { padding: 0 1rem; }
    .cta-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cta-short { display: inline; }
  }
  .site-nav ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  .site-nav a { color: inherit; text-decoration: none; font-size: 0.9375rem; }
  .site-nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.35em; }
  @media (max-width: 860px) { .site-nav { display: none; } }
  .site-header__inner { gap: var(--space-3); }
  .menu-btn {
    display: grid; place-items: center;
    width: 44px; height: 44px; padding: 0;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 50%; background: none; color: inherit; cursor: pointer;
  }
  .menu-btn svg, .menu-sheet__close svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  @media (min-width: 861px) { .site-header__inner { gap: var(--space-8); } .menu-btn { display: none; } }
  .menu-sheet {
    margin: auto 0 0; width: 100%; max-width: 100%; max-height: 85svh;
    border: 0; padding: 0;
    border-radius: 24px 24px 0 0;
    background: var(--surface); color: var(--ink);
    box-shadow: 0 -12px 40px rgb(60 40 20 / 0.18);
  }
  .menu-sheet::backdrop { background: rgb(30 24 20 / 0.35); }
  .menu-sheet[open] { animation: sheet-in var(--dur-enter) var(--ease-enter); }
  @keyframes sheet-in { from { transform: translateY(100%); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .menu-sheet[open] { animation: none; } }
  .menu-sheet__inner {
    position: relative;
    padding: 1.5rem max(1.5rem, env(safe-area-inset-left)) calc(2rem + env(safe-area-inset-bottom));
  }
  .menu-sheet__close {
    position: absolute; top: 0.75rem; right: 0.75rem;
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 0; border-radius: 50%; background: none; color: inherit; cursor: pointer;
  }
  .menu-sheet ul { list-style: none; margin: 0; padding: 0.5rem 0 0; display: grid; }
  .menu-sheet a {
    display: block; padding: 0.875rem 0;
    font-family: var(--font-display); font-size: 1.75rem; font-weight: 380;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line);
  }
  .menu-sheet a[aria-current='page'] { color: var(--terracotta-text); }

  .site-header__cta {
    min-height: 44px;
    padding: 0 1.25rem;
    font-size: 0.9375rem;
    transition:
      opacity var(--dur-leave) var(--ease-leave),
      visibility 0s linear var(--dur-leave),
      transform var(--dur-press) var(--ease-out),
      box-shadow var(--dur-press) var(--ease-out);
  }
  @media (min-width: 768px) { .site-header__cta { min-height: 48px; padding: 0 1.5rem; } }
  /* At most one button per screen: step aside when the sign-up itself is in view. */
  .site-header__cta[data-hidden] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .site-header__cta:not([data-hidden]) {
    transition:
      opacity var(--dur-enter) var(--ease-enter),
      visibility 0s,
      transform var(--dur-press) var(--ease-out),
      box-shadow var(--dur-press) var(--ease-out);
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const cta = document.querySelector<HTMLElement>('[data-header-cta]');
    if (!header || !cta) return;

    // Take tone from whatever sits under the header: the story stage stays
    // transparent over its sky; other sections get a soft solid bar.
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = header.offsetHeight + 2;
      const under = document.elementFromPoint(window.innerWidth / 2, y) as HTMLElement | null;
      const toned = under?.closest<HTMLElement>('[data-tone]');
      header.dataset.tone = toned?.dataset.tone === 'dark' ? 'dark' : 'light';
      const inStage = !!under?.closest('[data-stage]');
      header.toggleAttribute('data-solid', window.scrollY > 8 && !inStage);
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('story:active', schedule);

    // At most one button per screen: step aside while another primary button shows.
    const primaries = Array.from(document.querySelectorAll<HTMLElement>('[data-primary-cta]'));
    const visible = new Set<Element>();
    let io: IntersectionObserver | null = null;
    if (primaries.length) {
      io = new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
        cta.toggleAttribute('data-hidden', visible.size > 0);
      }, { rootMargin: '-8% 0px -8% 0px' });
      primaries.forEach((p) => io!.observe(p));
    }
    document.addEventListener('astro:before-swap', () => {
      io?.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      document.removeEventListener('story:active', schedule);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initHeader);

  function initMenu() {
    const sheet = document.querySelector<HTMLDialogElement>('[data-menu]');
    const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    if (!sheet || !open) return;
    open.addEventListener('click', () => sheet.showModal());
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', () => sheet.close());
    // Tap on the backdrop closes; following a link closes before the page changes.
    sheet.addEventListener('click', (e) => {
      if (e.target === sheet || (e.target as HTMLElement).closest('a')) sheet.close();
    });
  }
  document.addEventListener('astro:page-load', initMenu);
</script>
