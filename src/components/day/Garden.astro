---
/* Desktop only: a few garden plants anchoring the lower corners. */
---
<div class="garden" aria-hidden="true">
  <svg class="art garden__left" viewBox="0 0 260 220">
    <g class="a-l sway" style="--sway-dur: 7s">
      <path d="M40 220 C38 180 30 150 14 124 M52 220 C54 176 64 146 82 120 M64 220 C62 186 56 162 44 140 M76 220 C80 190 92 168 110 152" />
    </g>
    <g class="a-q sway" style="--sway-dur: 8s">
      <path d="M150 220 C150 170 152 130 156 92" />
      <path d="M156 100 C152 96 152 90 156 86 C160 90 160 96 156 100 Z M154 112 C150 108 150 102 154 98 M158 112 C162 108 162 102 158 98" />
      <path d="M170 220 C172 180 176 150 184 120" />
      <path d="M184 128 C180 124 180 118 184 114 C188 118 188 124 184 128 Z" />
    </g>
  </svg>
  <svg class="art garden__right" viewBox="0 0 260 220">
    <g class="a-l sway" style="--sway-dur: 6.5s">
      <path d="M130 220 C128 190 124 166 116 146" />
      <path d="M116 146 C104 142 98 130 102 118 C114 122 120 134 116 146 Z" />
      <path d="M126 180 C138 172 150 172 160 176 C150 186 136 186 126 180 Z" />
      <path d="M122 166 C110 160 100 160 92 164 C100 172 114 172 122 166 Z" />
      <path d="M200 220 C204 196 214 178 228 164 M214 220 C214 200 220 186 230 176 M188 220 C186 204 180 192 170 182" />
    </g>
  </svg>
</div>

<style>
  .garden { display: none; }
  @media (min-width: 960px) {
    .garden { display: block; position: absolute; inset: auto 0 0 0; height: 220px; pointer-events: none; }
    .garden svg { position: absolute; bottom: 0; width: 260px; height: 220px; }
    .garden__left { left: 2%; }
    .garden__right { right: 1%; }
  }
</style>
