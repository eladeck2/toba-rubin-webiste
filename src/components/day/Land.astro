---
/* Two soft hills with a few far-off trees. Fills follow --hill-far / --hill-near. */
---
<div class="land" data-land>
  <svg viewBox="0 0 1600 420" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
    <path class="land__far" d="M0 96 C180 46 400 52 610 92 C800 128 980 46 1220 56 C1390 63 1520 92 1600 86 V420 H0 Z" />
    <path class="land__far-line" d="M0 96 C180 46 400 52 610 92 C800 128 980 46 1220 56 C1390 63 1520 92 1600 86" />
    <g class="land__trees">
      <path d="M1424 70 L1424 52 M1424 58 C1416 54 1416 42 1424 36 C1432 42 1432 54 1424 58" />
      <path d="M1448 72 L1448 59 M1448 63 C1442 59 1442 50 1448 46 C1454 50 1454 59 1448 63" />
      <path d="M1470 74 L1470 55 M1470 61 C1461 57 1461 43 1470 36 C1479 43 1479 57 1470 61" />
      <path d="M318 62 L318 46 M318 51 C311 47 311 36 318 31 C325 36 325 47 318 51" />
      <path d="M340 64 L340 51 M340 55 C334 52 334 43 340 39 C346 43 346 52 340 55" />
    </g>
    <path class="land__near" d="M0 176 C230 132 470 142 720 180 C960 216 1200 136 1600 156 V420 H0 Z" />
    <path class="land__near-line" d="M0 176 C230 132 470 142 720 180 C960 216 1200 136 1600 156" />
  </svg>
</div>

<style>
  .land {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -60px;
    top: calc(100% - var(--card-zone) - 5rem);
    will-change: transform;
  }
  .land svg { width: 100%; height: 100%; }
  .land__far { fill: var(--hill-far); }
  .land__near { fill: var(--hill-near); }
  .land__far-line, .land__near-line, .land__trees path {
    fill: none;
    stroke: var(--art-i);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    opacity: 0.45;
  }
  .land__trees path { stroke: var(--art-l); opacity: 0.8; }
  @media (min-width: 960px) {
    .land { top: 62%; }
  }
</style>
