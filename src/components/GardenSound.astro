---
/**
 * Play the garden: a small round button, bottom left. Off until tapped.
 * Persisted across page transitions so the garden keeps playing between pages.
 * The audio module is only downloaded on the first tap.
 */
---

<div class="garden-sound" transition:persist="garden-sound" data-garden>
  <button class="garden-sound__btn" type="button" aria-pressed="false" data-garden-btn>
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path class="ripple r1" d="M11.5 11.5 C13.5 9.6 18.5 9.6 20.5 11.5" />
      <path class="ripple r2" d="M8.5 8 C12.5 4.6 19.5 4.6 23.5 8" />
      <path class="bowl" d="M6.5 15.5 H25.5 C25.5 21.5 21.5 25 16 25 C10.5 25 6.5 21.5 6.5 15.5 Z" />
      <path class="bowl" d="M13 25.5 L19 25.5" />
    </svg>
    <span class="garden-sound__label" data-garden-label>Play the garden</span>
  </button>
</div>

<style>
  .garden-sound {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    transition: opacity var(--dur-leave) var(--ease-leave), transform var(--dur-leave) var(--ease-leave);
  }
  .garden-sound__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--teal-text);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out), box-shadow var(--dur-press) var(--ease-out), background-color var(--dur-press) var(--ease-out);
  }
  .garden-sound__btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-lift); }
  .garden-sound__btn:focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; border-radius: 50%; }
  .garden-sound__btn svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .garden-sound__btn .ripple { opacity: 0.45; transform-origin: 16px 16px; }
  .garden-sound__btn[aria-pressed='true'] { background: var(--teal-text); color: var(--bg); border-color: transparent; }
  .garden-sound__btn[aria-pressed='true'] .ripple { opacity: 1; animation: ripple 2.6s ease-in-out infinite; }
  .garden-sound__btn[aria-pressed='true'] .r2 { animation-delay: 0.5s; }
  @keyframes ripple { 0%, 100% { opacity: 0.25; transform: translateY(1px); } 50% { opacity: 1; transform: translateY(-1px); } }

  .garden-sound__label {
    position: absolute;
    left: calc(100% + 0.625rem);
    top: 50%;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-4px, -50%);
    pointer-events: none;
    transition: opacity var(--dur-press) var(--ease-out), transform var(--dur-press) var(--ease-out);
  }
  @media (hover: hover) {
    .garden-sound__btn:hover .garden-sound__label { opacity: 1; transform: translate(0, -50%); }
  }
  .garden-sound__btn:focus-visible .garden-sound__label { opacity: 1; transform: translate(0, -50%); }

  @media (max-width: 767px) {
    :global(html[data-typing]) .garden-sound { opacity: 0; transform: translateY(12px); pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .garden-sound__btn[aria-pressed='true'] .ripple { animation: none; }
  }
</style>

<script>
  import type { Garden, Mix } from '../scripts/garden-audio';

  const KEY = 'tova:garden';
  const DEFAULT_MIX: Mix = { birds: 1, simmer: 0.6, crickets: 0 };
  let garden: Garden | null = null;
  let mix: Mix = DEFAULT_MIX;
  let bound = false;

  function setButton(on: boolean) {
    const btn = document.querySelector<HTMLButtonElement>('[data-garden-btn]');
    const label = document.querySelector<HTMLElement>('[data-garden-label]');
    if (!btn || !label) return;
    btn.setAttribute('aria-pressed', String(on));
    label.textContent = on ? 'Quiet the garden' : 'Play the garden';
  }

  async function toggle() {
    const on = !(garden?.running ?? false);
    setButton(on);
    try { localStorage.setItem(KEY, on ? 'on' : 'off'); } catch { /* ignore */ }
    if (on) {
      if (!garden) {
        const { Garden } = await import('../scripts/garden-audio');
        garden = new Garden();
      }
      await garden.start(mix);
    } else {
      await garden?.stop();
    }
  }

  function bind() {
    if (bound) return;
    const btn = document.querySelector<HTMLButtonElement>('[data-garden-btn]');
    if (!btn) return;
    bound = true;
    btn.addEventListener('click', toggle);

    // The garden follows the story; outside it, morning birds and a simmering pot.
    document.addEventListener('garden:mix', (e) => {
      mix = (e as CustomEvent<Mix>).detail;
      garden?.setMix(mix);
    });
    document.addEventListener('story:active', () => {
      if (!document.documentElement.hasAttribute('data-story-active') && !nightInView) {
        mix = DEFAULT_MIX;
        garden?.setMix(mix);
      }
    });
    document.addEventListener('visibilitychange', () => garden?.hide(document.hidden));

    // Hide the floating buttons while typing on a phone.
    document.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea, select')) document.documentElement.setAttribute('data-typing', '');
    });
    document.addEventListener('focusout', () => document.documentElement.removeAttribute('data-typing'));
  }

  // The closing night section keeps the crickets going.
  let nightInView = false;
  let io: IntersectionObserver | null = null;
  function watchNight() {
    io?.disconnect();
    const night = document.querySelector<HTMLElement>('[data-join-section]');
    if (!night) return;
    const sound = night.dataset.sound ? (JSON.parse(night.dataset.sound) as Mix) : { birds: 0, simmer: 0, crickets: 0.8 };
    io = new IntersectionObserver(([entry]) => {
      nightInView = entry.isIntersecting;
      if (nightInView) { mix = sound; garden?.setMix(mix); }
    }, { threshold: 0.35 });
    io.observe(night);
  }

  document.addEventListener('astro:page-load', () => {
    bind();
    watchNight();
    // Remembered "on" never autoplays: it waits for the visitor's tap on this button.
    setButton(garden?.running ?? false);
  });
</script>
