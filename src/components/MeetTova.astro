---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { home } from '../config/site';
const about = await getEntry('pages', 'about');
---

<section class="section section--tint meet" aria-labelledby="meet-title">
  <div class="container meet__inner">
    {about?.data.photo && (
      <figure class="meet__figure">
        <div class="photo meet__photo">
          <Image src={about.data.photo} alt={about.data.photoAlt ?? ''} widths={[443]} sizes="(min-width: 900px) 34rem, 100vw" />
        </div>
        {about.data.photoCaption && <figcaption>{about.data.photoCaption}</figcaption>}
      </figure>
    )}
    <div class="meet__text">
      <p class="eyebrow section__eyebrow">Meet Tova</p>
      <h2 class="section__title" id="meet-title">{about?.data.heading}</h2>
      {/* PENDING TOVA'S APPROVAL */}
      <p>For twenty years I worked as a clinical psychologist in the Washington, DC area. I saw how much food, rest and connection shape the way we feel.</p>
      <p>Today I’m a plant-based chef. I bring the same care to the kitchen table, where good conversations start.</p>
      <ul class="meet__facts">
        {home.proof.map((item) => <li><span set:html={item} /></li>)}
      </ul>
      <a class="text-link" href="/about/">Read my story</a>
    </div>
  </div>
</section>

<style>
  .meet__inner { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (min-width: 900px) { .meet__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } }
  .meet__figure { margin: 0; display: grid; gap: var(--space-3); }
  .meet__photo { aspect-ratio: 2 / 1; max-width: 100%; }
  .meet__figure figcaption { font-size: var(--step-small); color: var(--ink-soft); }
  .meet__text { display: grid; gap: var(--space-4); justify-items: start; max-width: 34rem; }
  .meet__text p { color: var(--ink-soft); }
  .meet__text .section__eyebrow { color: var(--teal-text); }
  .meet__facts { list-style: none; margin: var(--space-2) 0; padding: var(--space-4) 0 0; border-top: 1px solid var(--line); display: grid; gap: 0.35rem; font-size: var(--step-small); color: var(--ink-soft); width: 100%; }
  .meet__facts li { display: flex; gap: 0.6rem; align-items: baseline; }
  .meet__facts li::before { content: ''; flex: none; width: 4px; height: 4px; border-radius: 50%; background: var(--teal); transform: translateY(-0.2em); }
</style>
