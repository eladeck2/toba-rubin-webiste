---
/**
 * Ways to work with Tova, in her Round 3 ranking. The first offering is
 * featured (photo, facts, the page's primary button); the rest follow as a
 * quieter list with text links, so the hierarchy matches her priorities.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { isReady } from '../config/site';
import Window from './scenes/Window.astro';
import Kitchen from './scenes/Kitchen.astro';
import Walk from './scenes/Walk.astro';
import Desk from './scenes/Desk.astro';
import Tea from './scenes/Tea.astro';
import Table from './scenes/Table.astro';
import Night from './scenes/Night.astro';
import Chair from './scenes/Chair.astro';

const scenes = { window: Window, kitchen: Kitchen, walk: Walk, desk: Desk, tea: Tea, table: Table, night: Night, chair: Chair };
const items = (await getCollection('offerings'))
  .filter((o) => o.data.visible)
  .sort((a, b) => a.data.order - b.data.order);
const featured = items.find((o) => o.data.featured);
const rest = items.filter((o) => o !== featured);

type Link = { href: string; label: string; external: boolean };
function linkFor(d: (typeof items)[number]['data']): Link | null {
  if (isReady(d.href)) return { href: d.href!, label: `More about ${d.title}`, external: false };
  if (d.cta) return { href: d.cta.href, label: d.cta.label, external: false };
  if (d.external) return { href: d.external.url, label: d.external.label, external: true };
  if (d.invite) return { href: '#join', label: d.invite, external: false };
  return null;
}
const ext = (l: Link) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---

<section class="section offerings" id="ways" aria-labelledby="ways-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="ways-title">Ways to work with me</h2>
      <p class="section__lede">Everything happens in person, around North Bethesda. Each one starts with a conversation.</p>
    </header>

    {featured && (() => {
      const d = featured.data;
      const link = linkFor(d);
      return (
        <article class="feature" aria-labelledby="feature-title">
          {d.photo && (
            <div class="feature__media photo">
              <Image src={d.photo} alt={d.photoAlt ?? ''} widths={[400, 498]} sizes="(min-width: 900px) 30rem, 100vw" />
            </div>
          )}
          <div class="feature__text">
            <p class="offering__kind">{d.kind}</p>
            <h3 class="feature__title" id="feature-title">{d.title}</h3>
            <p class="feature__summary">{d.summary}</p>
            {d.facts && (
              <dl class="feature__facts">
                {d.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {link && <a class="btn" href={link.href} data-primary-cta {...ext(link)}>{link.label}</a>}
          </div>
        </article>
      );
    })()}

    <ul class="offerings__list">
      {rest.map((o) => {
        const d = o.data;
        const Scene = d.scene ? scenes[d.scene] : null;
        const link = linkFor(d);
        return (
          <li class="offering">
            <div class="offering__media photo" aria-hidden={d.photo ? undefined : 'true'}>
              {d.photo ? (
                <Image src={d.photo} alt={d.photoAlt ?? ''} widths={[240, 400]} sizes="(min-width: 768px) 12rem, 100vw" />
              ) : (
                Scene && <div class="offering__art"><Scene /></div>
              )}
            </div>
            <div class="offering__text">
              <p class="offering__kind">{d.kind}</p>
              <h3 class="offering__title">{d.title}</h3>
              <p class="offering__summary">{d.summary}</p>
              {link && <a class="text-link" href={link.href} {...ext(link)}>{link.label}</a>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  /* Featured: the first thing Tova wants people to book */
  .feature {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
  }
  .feature__media { aspect-ratio: 4 / 5; max-width: 100%; max-height: 36rem; }
  @media (max-width: 899px) { .feature__media { aspect-ratio: 4 / 3; } }
  .feature__text { display: grid; gap: var(--space-4); justify-items: start; min-width: 0; max-width: 34rem; }
  .feature__title { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); font-weight: 360; letter-spacing: -0.02em; }
  .feature__summary { color: var(--ink-soft); font-size: var(--step-lede); line-height: 1.5; }
  .feature__facts {
    width: 100%;
    margin: var(--space-2) 0 var(--space-4);
    display: grid;
    border-top: 1px solid var(--line);
  }
  .feature__facts > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .feature__facts dt { font-size: var(--step-small); color: var(--ink-soft); }
  .feature__facts dd { margin: 0; font-weight: 600; }

  /* The rest, as a quiet list */
  .offerings__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .offering {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4) clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3vw, 2rem) 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .offering:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 768px) {
    .offering { grid-template-columns: 12rem minmax(0, 1fr); align-items: center; }
  }
  .offering__media { aspect-ratio: 1; max-width: 100%; border-radius: 14px; }
  @media (min-width: 768px) { .offering__media { aspect-ratio: 4 / 3; border-radius: var(--radius-card); } }
  .offering__art {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    padding: 0.5rem;
    background: linear-gradient(to bottom, #F6E4D6, #F1DCC8);
    --paper: #F3DFCD;
  }
  @media (prefers-color-scheme: dark) {
    .offering__art { background: linear-gradient(to bottom, #3A2C25, #45332A); --paper: #3F3028; }
  }
  .offering__art :global(svg) { height: 100%; width: auto; max-width: 100%; }
  .offering__text { display: grid; gap: var(--space-2); justify-items: start; min-width: 0; max-width: 40rem; }
  .offering__kind { font-size: var(--step-small); color: var(--terracotta-text); font-weight: 600; }
  .offering__title { font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); font-weight: 380; }
  .offering__summary { color: var(--ink-soft); margin-bottom: var(--space-1); }
</style>
