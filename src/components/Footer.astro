---
import { footerLinks, disclaimer, site } from '../config/site';
interface Props { tone?: 'page' | 'night' }
const { tone = 'page' } = Astro.props;
const links = footerLinks.filter((l) => l.ready);
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { 'site-footer--night': tone === 'night' }]} data-tone={tone === 'night' ? 'dark' : undefined}>
  <div class="site-footer__inner">
    <p class="site-footer__mark">Tova Rubin</p>
    {links.length > 0 && (
      <ul class="site-footer__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    )}
    <p class="site-footer__note">{disclaimer}</p>
    <p class="site-footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-16) var(--gutter) calc(var(--space-16) + 4.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: var(--step-small);
  }
  .site-footer--night {
    --ink: #EDE3D6;
    --ink-soft: #B9B3C2;
    --teal-text: #8ED9D4;
    --line: rgb(237 227 214 / 0.12);
    background: #141827;
    color: var(--ink-soft);
  }
  @media (prefers-color-scheme: dark) { .site-footer--night { background: #0F121D; } }
  .site-footer__inner {
    max-width: 88rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
  .site-footer__mark {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: var(--space-6); list-style: none; padding: 0; margin: 0; }
  .site-footer__note { max-width: 46ch; }
  .site-footer__copy { opacity: 0.85; }
</style>
